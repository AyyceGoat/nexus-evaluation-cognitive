# ─────────────────────────────────────────────────────────────────────────────
# NEXUS — variables d'environnement
#
# Copier ce fichier en `.env` et renseigner les valeurs. `.env` est ignoré par Git.
#
# RÈGLE : avec Vite, TOUTE variable préfixée par VITE_ est inlinée dans le bundle
# JavaScript et devient donc PUBLIQUE. Aucun secret ne doit porter ce préfixe.
# Les secrets ci-dessous (sans préfixe) sont destinés aux fonctions serveur
# uniquement et se configurent dans le dashboard de l'hébergeur, jamais dans le
# dépôt.
#
# ÉTAT AU 9 SEPTEMBRE 2026 : le projet ne lit encore AUCUNE de ces variables.
# Le code ne contient aujourd'hui aucun `import.meta.env`. Ce fichier documente
# ce qui sera branché, phase par phase, pour qu'aucune clé n'atterrisse en dur
# dans le code comme c'est le cas actuellement de l'URL du site.
# ─────────────────────────────────────────────────────────────────────────────


# ── Général ──────────────────────────────────────────────────────────────────
# URL canonique du site. Sert à générer sitemap.xml, les balises canoniques et
# les URL de retour du paiement. Aujourd'hui codée en dur dans index.html et
# public/sitemap.xml (« https://taupe-lily-ac2081.netlify.app »).
VITE_SITE_URL="http://localhost:5173"


# ── Phase 4 — Supabase (auth + base + RLS) ───────────────────────────────────
# Publiques : la clé « anon » est conçue pour être exposée au navigateur ; c'est
# la Row Level Security qui protège les données, pas le secret de cette clé.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# SECRET — fonctions serveur uniquement. Contourne la RLS. Ne jamais préfixer
# VITE_, ne jamais committer, ne jamais exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=""


# ── Phase 5 — Paiement CinetPay ──────────────────────────────────────────────
# Publique : identifiant du site marchand, visible dans le widget de checkout.
VITE_CINETPAY_SITE_ID=""

# SECRETS — fonctions serveur uniquement.
CINETPAY_API_KEY=""
CINETPAY_SECRET_KEY=""

# Sélecteur d'implémentation du PaymentProvider.
#   sandbox = provider local, aucun appel réseau, pour développer et tester
#   cinetpay = provider réel
PAYMENT_PROVIDER="sandbox"

# Durée de vie d'une transaction PENDING avant passage automatique à EXPIRED.
PAYMENT_TRANSACTION_TTL_MINUTES="30"


# ── Analytics (optionnel) ────────────────────────────────────────────────────
# Le bloc Google Analytics d'index.html contient aujourd'hui un identifiant
# factice « G-XXXXXXXXXX » entouré d'une garde qui l'empêche de s'initialiser :
# c'est du code mort. Laisser vide tant qu'aucun identifiant réel n'existe.
VITE_GA_MEASUREMENT_ID=""
