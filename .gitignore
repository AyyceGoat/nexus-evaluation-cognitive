# Dépendances
node_modules/

# Sorties de build
dist/
dist.zip
*.zip

# Variables d'environnement — jamais commitées
.env
.env.*
!.env.example

# Outils locaux
.vite/
coverage/
*.tsbuildinfo
.eslintcache

# Système
Thumbs.db
Desktop.ini
.DS_Store

# Supabase (Phase 4) — état local et secrets
supabase/.branches/
supabase/.temp/

# Sorties de verification (captures, rapports Lighthouse) : reproductibles par
# npm run verifie:rendu et npm run verifie:lighthouse.
verification/

# Dossier local de la CLI Netlify : contient l'identifiant du site lie.
.netlify

# Échantillons de voix : artefacts d'une décision, pas du produit.
# Ils partent dans le déploiement de prévisualisation (Vite copie public/),
# mais 2,8 Mo de MP3 jetables n'ont rien à faire dans l'historique Git.
public/ecoute/*.mp3
public/ecoute/*.reperes.json
public/ecoute/manifeste.json
